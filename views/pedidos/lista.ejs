<%# MEUS PEDIDOS: cada pedido é um cartão com status, progresso e botão de acompanhar. Recebe: pedidos, formas, ETAPAS. %>
<%- include('../admin/partials/header') %>
<%- include('../partials/loja-topo') %>
<%- include('../partials/cabecalho-pagina', { caminho: [{ t: 'Meus pedidos' }], titulo: 'MEUS PEDIDOS', texto: '', pills: [], etapa: 0, etapaFeita: false }) %>

<main class="loja-pagina">
    <% if (!pedidos.length) { %>
        <div class="cartao-claro vazio-pedidos">
            <p>Você ainda não fez nenhum pedido.</p>
            <a class="sample-button sample-button-red" href="/">Ir para a loja</a>
        </div>
    <% } else { %>
        <div class="lista-pedidos">
            <% pedidos.forEach(p => {
                const posicao = ETAPAS.indexOf(p.status);
                const progresso = p.status === 'Cancelado' ? 0 : Math.round((posicao + 1) / ETAPAS.length * 100);
            %>
                <article class="cartao-pedido">
                    <header>
                        <div>
                            <strong>Pedido SP<%= String(p.id).padStart(5, '0') %></strong>
                            <small><%= p.criado_em %> · <%= formas[p.forma_pagamento] %> · <%= brl(p.total) %></small>
                        </div>
                        <span class="status-pedido status-<%= slugStatus(p.status) %>"><%= p.status %></span>
                    </header>
                    <div class="barra-progresso"><span style="width: <%= progresso %>%"></span></div>
                    <footer>
                        <small>Código de rastreio: <%= p.codigo_rastreio %></small>
                        <a class="sample-button sample-button-red" href="/pedidos/<%= p.id %>">Acompanhar entrega</a>
                    </footer>
                </article>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../partials/loja-rodape') %>
<%- include('../admin/partials/footer') %>
