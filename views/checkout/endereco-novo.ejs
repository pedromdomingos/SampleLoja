<%# NOVO ENDEREÇO: uma caixa só com todos os campos, como no Figma. Recebe: erro, dados. %>
<%- include('../admin/partials/header') %>
<%- include('../partials/loja-topo') %>
<%- include('../partials/cabecalho-pagina', { caminho: [{ t: 'Minha conta', u: '/conta' }, { t: 'Novo endereço' }], titulo: 'NOVO ENDEREÇO', texto: '', pills: [], etapa: 0, etapaFeita: false }) %>

<main class="loja-pagina">
    <section class="cartao-claro cartao-endereco">
        <% if (erro) { %><div class="sample-alert sample-alert-danger"><%= erro %></div><% } %>
        <form action="/checkout/endereco/novo" method="POST" class="form-endereco-figma">
            <div class="campo-linha-2">
                <div class="campo"><label>Apelido</label><input type="text" name="apelido" maxlength="30" placeholder="Casa, Trabalho..." value="<%= dados.apelido || '' %>"></div>
                <div class="campo"><label>Destinatário</label><input type="text" name="destinatario" value="<%= dados.destinatario || '' %>"></div>
            </div>
            <div class="campo-linha-2">
                <div class="campo"><label>CEP</label><input type="text" name="cep" placeholder="00000-000" maxlength="9" value="<%= dados.cep || '' %>"></div>
                <div class="campo"><label>Telefone</label><input type="text" name="telefone" placeholder="(00) 0 0000-0000" value="<%= dados.telefone || '' %>"></div>
            </div>
            <div class="campo-linha-3">
                <div class="campo campo-rua"><label>Rua</label><input type="text" name="rua" value="<%= dados.rua || '' %>"></div>
                <div class="campo"><label>Número</label><input type="text" name="numero" value="<%= dados.numero || '' %>"></div>
                <div class="campo"><label>Complemento</label><input type="text" name="complemento" value="<%= dados.complemento || '' %>"></div>
            </div>
            <div class="campo-linha-3">
                <div class="campo"><label>Bairro</label><input type="text" name="bairro" value="<%= dados.bairro || '' %>"></div>
                <div class="campo"><label>Cidade</label><input type="text" name="cidade" value="<%= dados.cidade || '' %>"></div>
                <div class="campo"><label>Estado</label><input type="text" name="estado" maxlength="2" placeholder="UF" value="<%= dados.estado || '' %>"></div>
            </div>
            <button class="sample-button sample-button-red botao-salvar" type="submit">SALVAR ENDEREÇO</button>
            <a class="voltar-link" href="/checkout">Cancelar</a>
        </form>
    </section>
</main>

<%- include('../partials/loja-rodape') %>
<%- include('../admin/partials/footer') %>
