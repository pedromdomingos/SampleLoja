<%# PÁGINA ÚNICA DE PRODUTO: serve para camisa, disco e instrumento.
    A rota manda 3 variáveis: produto (o produto do banco), especificacoes (vetor de detalhes) e relacionados (vetor de produtos).
    O que aparece na tela muda conforme o produto; a página é sempre a mesma. %>
<%- include('../admin/partials/header') %>
<%- include('../partials/loja-topo') %>
<%
    const podeComprar = !usuario || usuario.perfil === 'cliente';
    const preco = precoFinal(produto);

    // caminho percorrido: Início / Roupas / Nome do produto
    const pagina = paginaDoTipo(produto.tipo_produto);
    const caminho = [];
    if (pagina) caminho.push({ t: PAGINAS[pagina].rotulo, u: '/loja/' + pagina });
    caminho.push({ t: produto.nome });

    // vetor com os fundos das miniaturas
    const fundos = ['#ffffff', '#efe7d8', 'linear-gradient(135deg, #c6301e, #7e1b12)', 'linear-gradient(135deg, #4a3410, #1d150a)'];
    const tamanhosDisponiveis = ['P', 'M', 'G', 'GG'];
%>

<main class="loja-pagina">
    <section class="produto-detalhe">

        <div class="produto-galeria">
            <div class="produto-foto">
                <% if (produto.imagem) { %><img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>" onerror="this.onerror=null; this.src='/img/sem-foto.svg'"><% } %>
            </div>
            <div class="miniaturas">
                <% fundos.forEach((fundo, i) => { %>
                    <button type="button" class="miniatura <%= i === 0 ? 'ativa' : '' %>" data-fundo="<%= fundo %>" style="background: <%= fundo %>" aria-label="Foto <%= i + 1 %>">
                        <% if (produto.imagem) { %><img src="/uploads/<%= produto.imagem %>" alt="" onerror="this.onerror=null; this.src='/img/sem-foto.svg'"><% } %>
                    </button>
                <% }) %>
            </div>
        </div>

        <div class="produto-info">
            <div class="migalhas-claro"><%- include('../partials/migalhas', { caminho: caminho }) %></div>
            <h1><%= produto.nome %></h1>
            <% if (produto.artista || produto.genero) { %>
                <p class="produto-linha"><%= [produto.artista, produto.genero, produto.ano_lancamento].filter(Boolean).join(' · ') %></p>
            <% } %>

            <% if (avaliacoes.length > 0) { %>
                <div class="stars stars-grande">
                    <% for (let i = 1; i <= 5; i++) { %><i class="bi bi-star-fill <%= i <= Math.round(media) ? '' : 'off' %>"></i><% } %>
                    <span><%= media %> · <%= avaliacoes.length %> avaliaç<%= avaliacoes.length === 1 ? 'ão' : 'ões' %></span>
                </div>
            <% } %>

            <div class="produto-preco">
                <% if (produto.valor_promocional) { %><s><%= brl(produto.valor) %></s><% } %>
                <strong><%= brl(preco) %></strong>
            </div>
            <p class="produto-parcelas">ou 6x de <%= brl(preco / 6) %> sem juros · <%= brl(preco * 0.95) %> no Pix (5% off)</p>

            <%# só roupas têm tamanho. Cada botão é um link para o produto daquele tamanho (mesma peça, id diferente);
                 quando não existe aquele tamanho no banco, o botão fica desativado. %>
            <% if (produto.tipo_produto === 'roupa') { %>
                <div class="tamanhos">
                    <% tamanhosDisponiveis.forEach(t => { %>
                        <% if (t === produto.tamanho) { %>
                            <span class="tamanho ativo"><%= t %></span>
                        <% } else if (tamanhos[t]) { %>
                            <a class="tamanho" href="/produto/<%= tamanhos[t] %>"><%= t %></a>
                        <% } else { %>
                            <span class="tamanho indisponivel"><%= t %></span>
                        <% } %>
                    <% }) %>
                </div>
            <% } %>

            <% if (produto.estoque > 0) { %>
                <p class="produto-estoque <%= produto.estoque <= 5 ? 'baixo' : '' %>"><%= produto.estoque <= 5 ? 'Últimas ' + produto.estoque + ' unidades!' : 'Em estoque' %></p>
            <% } else { %>
                <p class="produto-estoque indisponivel">Indisponível no momento</p>
            <% } %>

            <div class="frete-calculo">
                <label for="cepFrete">Calcular frete e prazo</label>
                <div class="frete-calculo-linha">
                    <input type="text" id="cepFrete" placeholder="00000-000" inputmode="numeric" maxlength="9">
                    <button type="button" id="btnCalcularFrete">Calcular</button>
                </div>
                <div id="resultadoFrete" class="frete-resultado"></div>
            </div>

            <% if (podeComprar && produto.estoque > 0) { %>
                <form action="/carrinho/adicionar" method="POST" class="produto-compra">
                    <input type="hidden" name="produto_id" value="<%= produto.id %>">
                    <input type="hidden" name="voltar" value="<%= caminhoAtual %>">
                    <div class="qtd-label">Quantidade
                        <div class="qtd-step" data-qtd>
                            <button type="button" data-menos aria-label="Diminuir">−</button>
                            <input type="number" name="quantidade" value="1" min="1" max="<%= produto.estoque %>" aria-label="Quantidade">
                            <button type="button" data-mais aria-label="Aumentar">+</button>
                        </div>
                    </div>
                    <button type="submit" class="sample-button sample-button-ghost">ADICIONAR AO CARRINHO</button>
                    <button type="submit" name="comprar_agora" value="1" class="sample-button sample-button-red">COMPRAR AGORA</button>
                </form>
            <% } else if (!podeComprar) { %>
                <p class="muted">Você está vendo a loja como <%= usuario.perfil === 'admin' ? 'administrador' : 'funcionário' %>. Para comprar, entre com uma conta de cliente.</p>
            <% } %>

            <div class="abas-produto">
                <button type="button" class="aba-produto ativa" data-aba="descricao">Descrição</button>
                <button type="button" class="aba-produto" data-aba="especificacoes">Especificações</button>
                <button type="button" class="aba-produto" data-aba="avaliacoes">Avaliações</button>
            </div>

            <div data-painel-produto="descricao">
                <p class="produto-descricao"><%= produto.descricao %></p>
            </div>

            <div data-painel-produto="especificacoes" hidden>
                <dl class="data-list produto-specs">
                    <%# forEach repete uma linha (nome + valor) para cada item do vetor especificacoes %>
                    <% especificacoes.forEach(e => { %>
                        <dt><%= e.rotulo %></dt><dd><%= e.valor %></dd>
                    <% }) %>
                    <% if (produto.gravadora) { %><dt>Gravadora</dt><dd><%= produto.gravadora %></dd><% } %>
                    <% if (produto.peso) { %><dt>Peso</dt><dd><%= produto.peso %> g</dd><% } %>
                </dl>
            </div>

            <div data-painel-produto="avaliacoes" hidden>
                <% if (podeAvaliarProduto) { %>
                    <form action="/produto/<%= produto.id %>/avaliar" method="POST" class="form-avaliacao">
                        <p>Você comprou este produto. Deixe sua avaliação:</p>
                        <div class="estrelas-input">
                            <% for (let i = 5; i >= 1; i--) { %>
                                <input type="radio" name="nota" value="<%= i %>" id="nota<%= i %>"><label for="nota<%= i %>"><i class="bi bi-star-fill"></i></label>
                            <% } %>
                        </div>
                        <textarea name="comentario" maxlength="500" placeholder="Conte como foi sua experiência (opcional)"></textarea>
                        <button type="submit" class="sample-button sample-button-red">Enviar avaliação</button>
                    </form>
                <% } %>
                <% if (!avaliacoes.length) { %>
                    <p class="muted">Este produto ainda não tem avaliações.</p>
                <% } %>
                <% avaliacoes.forEach(a => { %>
                    <div class="avaliacao-item">
                        <div class="stars"><% for (let i = 1; i <= 5; i++) { %><i class="bi bi-star-fill <%= i <= a.nota ? '' : 'off' %>"></i><% } %></div>
                        <strong><%= a.nome %></strong>
                        <% if (a.comentario) { %><p><%= a.comentario %></p><% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <% if (relacionados.length) { %>
        <h2 class="store-title relacionados-titulo">VOCÊ TAMBÉM PODE GOSTAR</h2>
        <div class="produto-grid">
            <% relacionados.forEach(p => { %>
                <%- include('../partials/loja-card', { p: p, podeComprar: podeComprar, voltarPara: caminhoAtual, selo: '' }) %>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../partials/loja-rodape') %>
<%- include('../admin/partials/footer') %>
