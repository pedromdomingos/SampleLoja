<%# Painel de filtros (abre embaixo do botão "Filtros"). Recebe: secoes, selecionados, mostrarPromocao, aberto e limparUrl %>
<aside class="filtros-lateral" id="painelFiltros" <%= aberto ? '' : 'hidden' %>>
    <% secoes.forEach(secao => { %>
        <% if (secao.opcoes.length) { %>
            <details class="fsec" open>
                <summary><%= secao.rotulo %> <i class="bi bi-chevron-down"></i></summary>
                <div class="fsec-lista">
                    <% secao.opcoes.forEach(o => { %>
                        <label class="fopt">
                            <input type="checkbox" name="<%= secao.campo %>" value="<%= o.valor %>" <%= (selecionados[secao.campo] || []).map(String).includes(String(o.valor)) ? 'checked' : '' %>>
                            <span><%= o.rotulo %></span><% if (o.n) { %><em><%= o.n %></em><% } %>
                        </label>
                    <% }) %>
                </div>
            </details>
        <% } %>
    <% }) %>
    <% if (mostrarPromocao) { %>
        <div class="fsec fsec-promo">
            <label class="fopt"><input type="checkbox" name="promocao" value="1" <%= (selecionados.promocao || []).length ? 'checked' : '' %>><span>Só promoções</span></label>
        </div>
    <% } %>
    <div class="filtros-rodape"><a href="<%= limparUrl %>" class="filtros-limpar">Limpar filtros</a></div>
</aside>
